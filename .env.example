# Lessons Toolkit environment template
# Copy to `.env` and fill in account-specific values.

LESSONS_TRANSPORT=bedrock
LESSONS_BEDROCK_REGION=us-east-1

# Bedrock bearer token (if using API token auth). Leave blank when relying on AWS credentials.
LESSONS_BEDROCK_API_TOKEN=

# Claude inference profile ARNs (required for 4.x models).
LESSONS_BEDROCK_QUICK_PROFILE=arn:aws:bedrock:us-east-1:000000000000:inference-profile/your-haiku-profile
LESSONS_BEDROCK_FULL_PROFILE=arn:aws:bedrock:us-east-1:000000000000:inference-profile/your-sonnet-profile
LESSONS_BEDROCK_DEDUPE_PROFILE=arn:aws:bedrock:us-east-1:000000000000:inference-profile/your-haiku-profile
